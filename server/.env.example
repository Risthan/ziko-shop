# Copiez ce fichier en .env puis adaptez les valeurs.
NODE_ENV=development
PORT=3000
# `npm run db:local` lance un PostgreSQL local qui correspond à cette adresse :
DATABASE_URL=postgres://ziko:ziko@localhost:5433/ziko_shop
DATABASE_SSL=false
# Laissez vide en local pour créer des produits sans clé. Obligatoire en production.
ADMIN_API_KEY=
SEED_ON_START=true
CORS_ORIGINS=*
# Facultatif : active l'essayage en direct (clé sur https://fal.ai/dashboard/keys).
FAL_KEY=
